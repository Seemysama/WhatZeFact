# WhatZeFact Pipeline - Environment Variables
# Copy this to .env and fill in your keys

# Gemini API Key (free: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Pexels API Key (free: https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_api_key_here

# YouTube Publishing (optional)
# 1. Go to https://console.cloud.google.com
# 2. Enable "YouTube Data API v3"
# 3. Create OAuth2 credentials (Desktop App)
# 4. Download → rename to client_secrets.json → place in pipeline/
# Auth tokens are saved automatically after first login
